# Example .env for MSAL / Azure AD
# Copy this file to .env and fill in real values before starting the app.

# Azure AD application (client) ID
REACT_APP_AZURE_CLIENT_ID=<YOUR_CLIENT_ID>

# Authority (tenant or common). Example: https://login.microsoftonline.com/<TENANT_ID>
# Optional; defaults to https://login.microsoftonline.com/common
REACT_APP_AZURE_AUTHORITY=https://login.microsoftonline.com/common

# Redirect URI configured in the Azure AD App registration.
# Optional; defaults to the application origin (e.g. http://localhost:3000)
REACT_APP_AZURE_REDIRECT_URI=http://localhost:3000

# Scopes used in msalConfig.loginRequest (change in src/auth/msalConfig.js if you need additional scopes)
# Example: REACT_APP_AZURE_SCOPES=openid,profile,User.Read
